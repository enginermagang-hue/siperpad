{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "nuxt-ui": {
      "type": "remote",
      "url": "https://ui.nuxt.com/mcp",
      "enabled": true
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest"]
    },
    "vuetify-mcp": {
      "type": "remote",
      "url": "https://mcp.vuetifyjs.com/mcp"
    },
"vue-docs": {
"type": "remote",
"url": "https://mcp.vue-mcp.org/mcp"
}
  },
"permission": {
    "bash": {
      "npm run dev *": "deny",
      "npm run build *": "deny",
      "npx nuxt build *": "deny"
    }
  }
}
